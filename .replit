modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
GATEWAY_BASE_PATH = "/innovation"
BASE_PATH = "/innovation"
MATRIX_AUDIENCE = "matrix-innovation-hub"
MATRIX_PLATFORM_URL = "https://matrix-platform.replit.app"
MATRIX_SESSION_TTL_SECONDS = "28800"
